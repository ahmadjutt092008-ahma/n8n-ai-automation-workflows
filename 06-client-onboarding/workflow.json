      "parameters": {
        "formTitle": "AI Front Desk: clinic setup",
        "formDescription": "Thank you for choosing an AI front desk. This takes about 5 minutes. Your answers are used only to set up your agent.<br><br>Please do not include any patient information or passwords.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Clinic name",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Your name",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Work email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Country",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "United Kingdom"
                  },
                  {
                    "option": "Pakistan"
                  },
                  {
                    "option": "UAE"
                  },
                  {
                    "option": "Saudi Arabia"
                  },
                  {
                    "option": "Other"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Clinic website",
              "fieldType": "text",
              "placeholder": "https://"
            },
            {
              "fieldLabel": "Package",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "FAQ Front Desk"
                  },
                  {
                    "option": "Booking Agent"
                  },
                  {
                    "option": "Full AI Front Desk"
                  },
                  {
                    "option": "Custom"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Booking system or calendar",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "Google Calendar, Dentally, Software of Excellence, paper diary..."
            },
            {
              "fieldLabel": "Where should the AI talk to patients?",
              "fieldType": "checkbox",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Website chat"
                  },
                  {
                    "option": "WhatsApp"
                  },
                  {
                    "option": "Both"
                  }
                ]
              }
            },
            {
              "fieldLabel": "WhatsApp Business number",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "We already use the WhatsApp Business API"
                  },
                  {
                    "option": "We use the WhatsApp Business app only"
                  },
                  {
                    "option": "We need help setting it up"
                  },
                  {
                    "option": "Not using WhatsApp"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Opening hours",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "Mon-Fri 9am-5:30pm, Sat 9am-1pm..."
            },
            {
              "fieldLabel": "Treatments and prices",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "Check-up GBP 55 (30 min), Hygienist GBP 70 (30 min)..."
            },
            {
              "fieldLabel": "Top questions patients ask",
              "fieldType": "textarea",
              "placeholder": "Parking? Do you take NHS patients? Payment plans?"
            },
            {
              "fieldLabel": "Emergency and urgent rules",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "What should happen with pain, swelling or bleeding? Same-day slots? Who calls back?"
            },
            {
              "fieldLabel": "Who gets urgent handovers? (email)",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Preferred go-live date",
              "fieldType": "date"
            },
            {
              "fieldLabel": "Confirm",
              "fieldType": "checkbox",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "I have not included any patient information in this form, and I will never share passwords here."
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "appendAttribution": false,
          "path": "dental-client-onboarding",
          "buttonLabel": "Send setup details",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Thank you! Ahmad will confirm the next steps by email."
            }
          }
        }
      }
    },
