        "sendTo": "you@example.com",
        "subject": "=New client setup: {{ $('Client Onboarding Form').item.json['Clinic name'] }}",
        "emailType": "text",
        "message": "=New client onboarding form.\n\nClinic: {{ $('Client Onboarding Form').item.json['Clinic name'] }}\nContact: {{ $('Client Onboarding Form').item.json['Your name'] }} ({{ $('Client Onboarding Form').item.json['Work email'] }})\nPackage: {{ $('Client Onboarding Form').item.json['Package'] }}\nBooking system: {{ $('Client Onboarding Form').item.json['Booking system or calendar'] }}\nGo-live: {{ $('Client Onboarding Form').item.json['Preferred go-live date'] || 'not set' }}\n\nAll answers are saved in the dental_clients table. Next: follow the onboarding checklist.",
