    {
      "id": "1fa295eb-3525-4149-9f75-dd4132fc0dc7",
      "name": "Welcome Email Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "=Next steps for your AI front desk: {{ $('Client Onboarding Form').item.json['Clinic name'] }}",
        "emailType": "text",
        "message": "=Hi {{ $('Client Onboarding Form').item.json['Your name'] }},\n\nThanks, I have everything I need to start building the AI front desk for {{ $('Client Onboarding Form').item.json['Clinic name'] }}.\n\nWhat happens next:\n1. Within 2 working days: I set up your agent with your hours, treatments, prices and FAQs.\n2. You get a private test link and a short recorded walkthrough. Please try it like a patient would.\n3. You send any changes by email. I update and re-test.\n4. We agree a go-live date, connect your website chat or WhatsApp, and I watch the first week closely.\n\nSafety rules from day one: the AI never gives medical advice, always asks before booking, and sends pain, emergencies and anything unclear to {{ $('Client Onboarding Form').item.json['Who gets urgent handovers? (email)'] }}.\n\nPlease never send passwords or patient information by email. When access to a calendar or WhatsApp account is needed, I will send step-by-step instructions so you can connect it yourself.\n\nAhmad Hassan\nAgentic AI for Dental Clinics",
        "options": {
          "sendTo": "={{ $('Client Onboarding Form').item.json['Work email'] }}"
        }
      }
    },
